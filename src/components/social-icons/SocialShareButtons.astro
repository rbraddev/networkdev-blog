---
import FacebookShareButton from "./social-buttons/FacebookShareButton.astro";
import LinkedInShareButton from "./social-buttons/LinkedInShareButton.astro";
import RedditShareButton from "./social-buttons/RedditShareButton.astro";
import TwitterShareButton from "./social-buttons/TwitterShareButton.astro";

type Props = {
  title: string;
  description: string;
  via?: string;
  border?: boolean;
  class?: string;
};

const { title, description, via, border = true } = Astro.props;
---

<div
  class:list={[
    "not-prose flex flex-wrap items-center justify-center gap-x-4 gap-y-3 py-5",
    border && "border-t border-gray-200 dark:border-gray-800",
    Astro.props.class,
  ]}
>
  <span
    class="flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300"
  >
    <svg
      class="h-4 w-4 text-primary-500"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    Share this post
  </span>
  <div class="flex items-center gap-2.5">
    <FacebookShareButton />
    <LinkedInShareButton />
    <RedditShareButton {title} />
    <TwitterShareButton {description} {via} />
  </div>
</div>

<style is:global>
  .social-share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background-color: #ffffff;
    color: #4b5563;
    border: 1px solid rgb(229 231 235);
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .dark .social-share-btn {
    background-color: rgb(31 41 55);
    color: rgb(156 163 175);
    border-color: rgb(55 65 81);
  }

  .social-share-btn svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
    transition: fill 0.18s ease;
  }

  .social-share-btn:hover {
    background-color: var(--brand);
    border-color: var(--brand);
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 8px 18px -6px color-mix(in srgb, var(--brand) 65%, transparent);
  }

  .social-share-btn:hover svg {
    fill: #ffffff;
  }
</style>
